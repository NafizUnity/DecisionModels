# LLM picker settings, read by picker_run.sh.
# Copy to picker.conf (kept out of git) and edit the paths: cp picker.conf.example picker.conf
# Plain bash: no spaces around '='; quote values with spaces.

# The LLM's folder (config.json, tokenizer, safetensors). On a server set up for MedDecider-31B this is the base model
# realdata_setup.sh placed under MODELS: $MODELS/gemma-4-31b-it (google/gemma-4-31b-it @ 842da379).
LLM_MODEL="/path/to/models/gemma-4-31b-it"

# Conda env that runs the LLM (transformers 5.22.2, torch 2.8, pyyaml, tqdm): the medical models' env.
LLM_ENV="realdata-med"

# Where the decision-model run folders are (realdata.conf RESULTS_DIR); picker_run.sh --dm-run names one of them.
DM_RESULTS_DIR="/path/to/RealData/results"

# Clinical notes for picker_run.sh --note first: one JSON line per note with note_id and note_text (the note_id the
# DM's fused ranking file gives each entity). Leave as is for runs without notes.
NOTES="/path/to/notes.jsonl"

# Where picker folders go (one subfolder per build). They hold entity text and notes: keep them on the server.
PICKER_RESULTS_DIR="/path/to/RealData/picker_results"

# The conda that holds LLM_ENV (realdata_setup.sh installs it as BASE/miniforge3/bin/conda). Empty = conda on PATH.
CONDA=""

# Physical GPU index (Gemma 4 31B in bf16 needs about 62 GB).
GPU=0
